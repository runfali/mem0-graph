# =============================================================================
# mem0 Server 环境变量 — 基础设施配置
# =============================================================================
# 复制本文件为 .env 后按需修改。
# docker-compose 启动时会自动加载同目录下的 .env。
#
# ⚠️ 模型配置（LLM / Embedder / Reranker / Graph Store 的 provider、api_key、
#   model、api_base）请写在 config.json 中，不要放在这里。
#   详见 config.json.example。
#
# 生产部署时需额外设置以下变量（compose 中使用 ${VAR:-default} 语法，
# 此处定义即覆盖默认值，不定义则使用 localhost 默认值）：
#   DASHBOARD_URL — Dashboard 完整 URL（http://IP:3002），用于 CORS / cookie secure 判断
#   API_EXTERNAL_URL — API 外部访问地址（http://IP:8888），Dashboard 浏览器端调此地址
#   NODE_ENV — Next.js 运行模式，生产部署建议 production
# =============================================================================

# ── 生产部署（compose 变量替换） ──────────────────────────────────────────────
# compose 中使用 ${VAR:-default}，以下在 .env 中定义即覆盖默认值。
# 部署到非本机时必须设置，不设则默认 localhost（仅本机可用）。

# Dashboard 完整 URL（用于 CORS 来源 + cookie secure 协议判断）
# DASHBOARD_URL=http://你的IP:3002
# API 外部访问地址（Dashboard 浏览器端调此地址访问 API）
# API_EXTERNAL_URL=http://你的IP:8888
# Next.js 运行模式（development / production）
# NODE_ENV=production

# ── Postgres ────────────────────────────────────────────────────────────────

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

# ── FalkorDB 图存储 ─────────────────────────────────────────────────────────

FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_DATABASE=mem0

# ── 认证与安全 ──────────────────────────────────────────────────────────────

ADMIN_API_KEY=
JWT_SECRET=
# 设为 true 时跳过 API Key 验证（仅内网开发环境，生产环境必须 false）
# AUTH_DISABLED=false

# ── 配置路径 ────────────────────────────────────────────────────────────────

# 指定 config.json 路径（docker-compose 已将 config.json 挂载到 /app/config.json）
# MEM0_CONFIG_PATH=/app/config.json

# 仅本地开发时设为 true。生产环境务必保持 false。
AUTH_DISABLED=false

# Mem0 Cloud API Key（使用 mem0 云端服务时需要）
# 如果同时部署了本 Server，则无需此项；仅在使用 mem0 云平台 SDK 时设置。
# MEM0_API_KEY=

# ── Dashboard ───────────────────────────────────────────────────────────────
# DASHBOARD_URL 请在上方「生产部署」段中设置

# ── 配置文件 ────────────────────────────────────────────────────────────────

# Provider 配置 JSON 文件路径（替代 /configure API）
# 此文件包含 LLM / Embedder / Reranker / Graph Store 的 provider 配置
MEM0_CONFIG_PATH=/app/config.json

APP_DB_NAME=mem0_app

# Mem0 数据/配置目录。CLI 模式和 SDK 本地模式用此路径存储配置和历史。
# 默认 ~/.mem0，Server 模式下通常无需设置。
# MEM0_DIR=/app/.mem0

# ── 历史记录 ────────────────────────────────────────────────────────────────

HISTORY_DB_PATH=/app/history/history.db

# ── Telemetry ───────────────────────────────────────────────────────────────

# 匿名遥测（仅发送一次安装事件：install UUID、邮箱域名、server version、source）。无 PII。
MEM0_TELEMETRY=true
# MEM0_TELEMETRY_STATE_PATH=/app/history/telemetry.json
# MEM0_TELEMETRY_SAMPLE_RATE=0.1  # SDK 遥测采样率（0.0-1.0，默认 1.0）

# ── 日志清理 ────────────────────────────────────────────────────────────────

# prune-logs 执行时保留多少天的 request_logs 历史
REQUEST_LOG_RETENTION_DAYS=30

# ═════════════════════════════════════════════════════════════════════════════
# 性能调优
# ═════════════════════════════════════════════════════════════════════════════

# ── 数据库连接池 ────────────────────────────────────────────────────────────

# MEM0_DB_POOL_SIZE=10            # SQLAlchemy pool_size
# MEM0_DB_MAX_OVERFLOW=20         # pool 满载后可额外创建的连接数
# MEM0_DB_POOL_RECYCLE=3600       # 连接最大存活秒数（-1 = 不回收）
# MEM0_DB_POOL_TIMEOUT=30         # 等待空闲连接的超时秒数

# ── 向量库连接池（pgvector）──────────────────────────────────────────────────

# MEM0_VECTOR_MINCONN=3            # pgvector 最小连接数
# MEM0_VECTOR_MAXCONN=10           # pgvector 最大连接数

# ── LLM 调优 ────────────────────────────────────────────────────────────────

# MEM0_LLM_TEMPERATURE=0.2        # 记忆提取温度（0-2，越低越确定）
# MEM0_LLM_MAX_TOKENS=2000        # 单次 LLM 调用最大输出 token
# MEM0_LLM_MAX_INPUT_TOKENS=6000    # 兼容旧配置（已由 MEM0_LLM_CONTEXT_WINDOW 取代，未设置 CONTEXT_WINDOW 时回退使用）
# MEM0_LLM_CONTEXT_WINDOW=16384     # LLM 上下文窗口总大小（n_ctx）。分块按此计算并预留输出余量，
#                                  #   避免 chunk 逼近窗口上限被截断（llama.cpp truncated=1）。
#                                  #   8K 显存 llama.cpp（n_ctx=16384）建议设 16384。
#                                  #   依赖 tiktoken（requirements.txt 已含）：容器无 tiktoken 时估算 fallback len//4，对中文严重低估
# MEM0_LLM_TIMEOUT=60             # LLM HTTP 请求超时秒数
# MEM0_LLM_MAX_RETRIES=2          # LLM 请求失败最大重试次数
# MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14  # 服务端默认 LLM 模型（config.json 未指定时生效）

# LLM 多层兜底（fallbacks）：主 LLM 失败时按顺序切换到兜底层。
# 设置 FALLBACK_MODEL 即启用第 1 层兜底；再设置 FALLBACK2_MODEL 启用第 2 层兜底。
# 未设置对应变量则跳过该层。DB overrides / config.json 中的 fallbacks 优先于这里的 env 默认值。
# MEM0_LLM_FALLBACK_MODEL=deepseek-chat        # 兜底 1 模型
# MEM0_LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1  # 兜底 1 Base URL（缺省同主 LLM）
# MEM0_LLM_FALLBACK_API_KEY=sk-xxx             # 兜底 1 API Key（缺省同主 LLM）
# MEM0_LLM_FALLBACK2_MODEL=                   # 兜底 2 模型
# MEM0_LLM_FALLBACK2_BASE_URL=                # 兜底 2 Base URL
# MEM0_LLM_FALLBACK2_API_KEY=                 # 兜底 2 API Key
# MEM0_LLM_FALLBACK2_REASONING_EFFORT=        # 兜底 2 推理强度（如 high/low，可选项）

# ── Embedder 调优 ───────────────────────────────────────────────────────────

# MEM0_EMBEDDING_DIMS=1536        # 向量维度（自动检测，通常无需设置）
# MEM0_EMBEDDING_BATCH_SIZE=100   # 批量嵌入每批最大条数
# MEM0_EMBEDDER_TIMEOUT=60        # Embedder HTTP 请求超时秒数
# MEM0_EMBEDDER_MAX_RETRIES=2     # Embedder 请求失败最大重试次数
# MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small  # 服务端默认 Embedder 模型（config.json 未指定时生效）

# ── Reranker 调优 ───────────────────────────────────────────────────────────
#
# 通过 config.json 配置 Provider 后，Server /search API 自动启用重排序。
# 支持：siliconflow / zero_entropy / cohere / sentence_transformer / huggingface / llm_reranker
# 详见：https://docs.mem0.ai/components/rerankers/config
#
# MEM0_RERANK_TIMEOUT=60          # Reranker HTTP 请求超时秒数
# MEM0_RERANK_MAX_RETRIES=3       # Reranker 请求失败最大重试次数（仅重试 429/500/502/503/超时，400 不重试）
# MEM0_RERANK_REQUEST_DELAY=0     # LLMReranker 逐文档调 LLM 时每次请求间隔（秒），防 RPM 限制
# MEM0_RERANK_QUERY_MAX_CHARS=4000  # SiliconFlow rerank query 截断阈值（字符数，防 API 400 "Query is too long"）
# MEM0_RERANK_DOCS_MAX_CHARS=6000   # SiliconFlow rerank documents 分批阈值（总字符数超限自动分批再合并 top_k）
#
# SiliconFlow reranker 额外行为（自动生效，无需配置）：
#   - query 超过 4000 字符时自动截断（避免 API 400 "Query is too long"）
#   - documents 总字符数超过 6000 时自动分批请求再合并 top_k
#   - 429/500/502/503/超时自动指数退避重试（1s→2s→4s…，上限 10s）
#   - 400 等参数错误不重试，降级为 score=0 并记录 WARNING 日志

# ── Hermes 集成调优 ─────────────────────────────────────────────────────────
#
# hermes plugins/memory/mem0 的 SelfHostedBackend 通过 HTTP 调用 mem0 server。
# 200K+ 上下文时 add 请求处理时间较长（LLM extraction + batch embed），需要
# 足够的 HTTP 超时，否则 hermes 日志会报 "Mem0 sync failed: timed out"。
#
# MEM0_SYNC_TIMEOUT=120            # hermes → mem0 server HTTP 超时秒数（默认 120）

# ── Graph Store 调优 ────────────────────────────────────────────────────────

# MEM0_GRAPH_MAX_WORKERS=5        # 图实体提取并发数（写池，1 = 串行）
# MEM0_GRAPH_SEARCH_WORKERS=2    # 图搜索线程池（与写池分离，批量写入时写任务不阻塞搜索）
# MEM0_GRAPH_SEARCH_TOKENS=0     # 参与图搜索的 token 上限（0 = 不限制）。图数据用独立 embedder 时通常不需要，与 voyageai 共用时可设 15-25
# MEM0_GRAPH_THRESHOLD=0.7       # 图搜索相似度阈值（0-1）
# MEM0_RERANK_SCORE_THRESHOLD=0.4  # rerank 阈值过滤（默认 0.4）：低于此分的向量结果被过滤；前缀命中图碎片（recall_channel=contains）豁免
# MEM0_VECTOR_SCORE_FALLBACK=0.5   # 向量分数兜底（默认 0.5，0=关闭）：rerank 分低于阈值但向量分达标的保留

# ── 记忆衰减 ────────────────────────────────────────────────────────────────

# MEM0_ENABLE_DECAY=false         # true=启用记忆衰减（搜索时按时间加权）
# MEM0_DECAY_HALF_LIFE_DAYS=30   # 衰减半衰期天数

# ── 搜索深度路由（search depth routing）────────────────────────────────────────

# MEM0_SEARCH_DEPTH_AUTO=true     # true=自动判定搜索深度（基于关键词匹配，非 LLM）
# MEM0_SEARCH_DEPTH_DEFAULT=full  # 默认搜索深度（minimal / standard / full）
# MEM0_SEARCH_CACHE_TTL=0         # minimal 路径缓存 TTL 秒，0=禁用
# MEM0_SEARCH_STD_CACHE_TTL=0     # standard 路径缓存 TTL 秒，0=禁用

# ── 记忆清理 ─────────────────────────────────────────────────────────────────

# MEMORY_RETENTION_DAYS=0         # 超期记忆清理天数（0 = 仅清理显式过期记忆）
# PRUNE_DRY_RUN=true              # 干跑模式（只报告不删除）

# ── 定期合并 ─────────────────────────────────────────────────────────────────

# CONSOLIDATION_DRY_RUN=true      # 干跑模式
# CONSOLIDATION_MIN_GROUP=3       # 触发合并的最少记忆条数

# ── 矛盾检测 ─────────────────────────────────────────────────────────────────

# MEM0_ENABLE_CONTRADICTION=false  # true=启用写入时矛盾检测（复用 LLM 提取）

# ── 其他 Provider Key（按需启用 — ⚠️ 更推荐写在 config.json 中） ──────────

# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# COHERE_API_KEY=
# ZERO_ENTROPY_API_KEY=

# ── 数据面限流（可选） ──────────────────────────────────────────────────────
# 除 /auth/* 的全部接口共用一个固定窗口配额；/auth 路由保留更严格的独立限流。
# MEM0_RATE_LIMIT_DATA=120/minute
# 计数器存 Redis（多 worker/多副本共享窗口）；不设则用进程内存。
# MEM0_RATE_LIMIT_REDIS=redis://falkordb:6379/1
# 仅当部署在会覆写 X-Forwarded-For 的反代之后才开启，否则客户端可伪造限流键。
# MEM0_TRUST_PROXY_HEADERS=false
